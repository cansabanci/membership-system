{
  "name": "odtu_uyekayit",
  "version": "1.0.0",
  "description": "Mersin ODTÜ Mezunları Üye Kayıt Sistemi",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "server": "node server/index.js",
    "server:verify": "node server/scripts/verifyApi.js"
  },
  "build": {
    "appId": "com.mersinodtu.uyekayit",
    "productName": "ODTU_UyeKayit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.git",
      "!.claude",
      "!dist",
      "!dist.zip",
      "!export/**/*",
      "!.env",
      "!.env.example",
      "!.gitignore",
      "!resources/**/*",
      "!*.md",
      "!server/**/*"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "export",
        "to": "export"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^35.0.3",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^148.0.0",
    "helmet": "^8.3.0",
    "mssql": "^11.0.1"
  }
}
